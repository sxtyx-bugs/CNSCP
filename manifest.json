{
  "manifest_version": 3,
  "name": "WhatsApp Contacts & DM CSV Exporter | satuxcodes",
  "short_name": "satuxcodes Exporter",
  "version": "1.2.0",
  "description": "Clean, one-click open-source WhatsApp Web contact and unsaved DM exporter to CSV. Built by satydev at satuxcodes.",
  "author": "satydev (satuxcodes)",
  "homepage_url": "https://github.com/sxtyx-bugs",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "WhatsApp Contacts & DM CSV Exporter | satuxcodes",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "permissions": [
    "scripting"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "src/countries.js",
        "src/xlsx-writer.js",
        "src/content.js"
      ],
      "css": [
        "src/styles.css"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
